# ===================================================
# Frontend Environment Variables (Vite)
# ===================================================
# Copy this file to .env.local for local dev (git-ignored)
# Set these in Netlify → Site Settings → Environment Variables for production

# Backend API URL
# - Local dev: leave empty (Vite proxy handles /api → localhost:3001)
# - Production: full Render URL, e.g. https://starlink-giveaway-backend.onrender.com
VITE_API_URL=
